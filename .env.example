# Copiar a .env y cambiar los valores. NO subir .env a git.

# Nombre con el que se entra al sistema: https://tce
# (cada PC debe resolver 'tce' hacia la IP del servidor; ver DEPLOY.md)
SITE_ADDRESS=tce

DB_NAME=inventory_system
DB_USER=tce
DB_PASSWORD=cambia_esta_clave
MYSQL_ROOT_PASSWORD=cambia_esta_otra_clave

# Generar con: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_valor_largo_aleatorio

TZ=America/La_Paz
